if [[ -n "${MANOR_REAL_PATH:-}" ]]; then
  export PATH="/opt/manor/worker/install-guard-bin:${MANOR_REAL_PATH}"
elif [[ ":${PATH}:" != *":/opt/manor/worker/install-guard-bin:"* ]]; then
  export PATH="/opt/manor/worker/install-guard-bin:${PATH}"
fi

if [[ -f "${HOME}/.cargo/env" ]]; then
  source "${HOME}/.cargo/env"
fi

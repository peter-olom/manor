# Manor local configuration
#
# Copy this file to .env or run ./install.sh to generate one.
# Do not commit .env. It may contain local secrets and auth settings.

BUTLER_HOST_PORT=8180

# Preview routes use the Manor gateway by default. Set the public base URL
# when the gateway is reached through a tailnet name, tunnel, or custom host.
RUNTIME_OPERATOR_BASE_URL=http://127.0.0.1:8180

# Legacy direct preview host ports are disabled by default.
RUNTIME_PREVIEW_HOST_PORTS=0

# Host controller restart/update runs inside a Linux container and talks to
# the host Docker daemon. On Linux hosts, keep this equal to the absolute host
# checkout path so Compose bind mounts resolve to paths the host daemon can use.
MANOR_HOST_PROJECT_DIR=

# Optional host-side project path. Leave empty to let Compose use the current
# checkout directory through PWD.
MANOR_HOST_PROJECT_SOURCE_DIR=
MANOR_SELF_IMPROVEMENT_SOURCE_CWD=/repos/manor

# Source-first mode is the default power-user path. Set this to 0 to use
# packaged images instead.
MANOR_BUILD_FROM_SOURCE=1
MANOR_IMAGE_REGISTRY=ghcr.io/peter-olom
MANOR_IMAGE_TAG=latest

# Required. The installer generates a local value automatically.
# If configuring manually, use a long random value.
RUNTIME_BROKER_TOKEN=

# Required. Separate restart/update capability token for the host controller.
# The installer generates a local value automatically.
MANOR_HOST_CONTROLLER_TOKEN=

# Optional package auto-update behavior at container startup.
# Codex service tier. auto chooses the lowest reliable tier for this stack.
CODEX_SERVICE_TIER=auto
MANOR_CODEX_AUTO_UPDATE=0
MANOR_CODEX_AUTO_UPDATE_VERSION=latest
MANOR_CODEX_AUTO_UPDATE_REQUIRED=0
MANOR_PI_AUTO_UPDATE=0
MANOR_PI_AUTO_UPDATE_VERSION=latest
MANOR_PI_AUTO_UPDATE_REQUIRED=0

# Optional Manor memory synthesis/review configuration. Synthesis runs via
# read-only codex exec for graph/entity/relationship extraction and durable
# memory candidate review. The default model is intentionally configurable.
MANOR_MEMORY_SYNTHESIS_ENABLED=1
MANOR_MEMORY_SYNTHESIS_MODEL=5.4 mini
MANOR_MEMORY_SYNTHESIS_TIMEOUT_MS=90000
MANOR_MEMORY_SYNTHESIS_MAX_INPUT_CHARS=16000
MANOR_MEMORY_SYNTHESIS_MAX_CANDIDATES=6

# Optional fast Codex exec pass for naming new Butler sessions from the first
# user prompt. Defaults to the memory synthesis model and a short timeout.
MANOR_SESSION_TITLE_MODEL=
MANOR_SESSION_TITLE_TIMEOUT_MS=15000

# Optional auth bootstrap. Leave empty when using device-code login.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=

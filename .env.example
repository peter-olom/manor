# Manor local configuration
#
# Copy this file to .env or run ./manor-start install to generate one.
# Do not commit .env. It may contain local secrets and auth settings.

BUTLER_HOST_PORT=8180
MANOR_START_WAIT_TIMEOUT=300
MANOR_UPDATE_WAIT_TIMEOUT=900

# Preview routes use the Manor gateway by default. Set the public base URL
# when the gateway is reached through a tailnet name, tunnel, or custom host.
RUNTIME_OPERATOR_BASE_URL=http://127.0.0.1:8180

# Host controller restart/update runs inside a Linux container and talks to
# the host Docker daemon. On Linux hosts, keep this equal to the absolute host
# checkout path so Compose bind mounts resolve to paths the host daemon can use.
MANOR_HOST_PROJECT_DIR=

# Optional host-side project path. Leave empty to let Compose use the current
# checkout directory through PWD.
MANOR_HOST_PROJECT_SOURCE_DIR=
MANOR_SELF_IMPROVEMENT_SOURCE_CWD=/repos/manor

# Required. The installer generates a local value automatically.
# If configuring manually, use a long random value.
RUNTIME_BROKER_TOKEN=

# Required. Separate restart/update capability token for the host controller.
# The installer generates a local value automatically.
MANOR_HOST_CONTROLLER_TOKEN=

# Managed settings
#
# These operational values are seed-only. Manor imports them into Settings on
# first startup, then UI-edited settings take precedence. Set
# MANOR_SETTINGS_RESEED=1 for one startup to re-import env values for groups
# that have not been edited in the UI.
#
# Secrets stay outside Manor settings. Inject them before Manor starts with
# env, *_FILE env vars, or Asiri; Manor stores only the reference metadata.
MANOR_SETTINGS_RESEED=0

# Operator name Butler uses in chat. Leave blank for no name.
MANOR_OPERATOR_NAME=

# Operator timezone as an IANA identifier (e.g. Europe/Berlin). Used for
# automation scheduling and time displays across Butler and Worker.
# Leave blank or invalid to default to UTC.
MANOR_OPERATOR_TIMEZONE=

# Which provider Butler and the default Worker should use.
# Options: openai-codex, ollama-local, ollama-cloud, opencode-go
MANOR_BUTLER_PROVIDER=openai-codex
# Default Worker provider seed.
MANOR_WORKER_PROVIDER=openai-codex

# Ollama Local provider seed for Butler, Pi Workers, and Pi background tasks.
# Uses the bundled Docker Ollama service by default. Pull a chat model before use.
MANOR_OLLAMA_LOCAL_ENABLED=1
MANOR_OLLAMA_LOCAL_PROVIDER_ID=ollama-local
MANOR_OLLAMA_LOCAL_BASE_URL=http://ollama:11434/v1
MANOR_OLLAMA_LOCAL_NATIVE_BASE_URL=http://ollama:11434
MANOR_OLLAMA_LOCAL_API=openai-completions
MANOR_OLLAMA_LOCAL_MODELS=
MANOR_OLLAMA_LOCAL_CONTEXT_WINDOW=65536
MANOR_OLLAMA_LOCAL_MAX_TOKENS=16384
MANOR_OLLAMA_LOCAL_REASONING=1
OLLAMA_LOCAL_API_KEY=
OLLAMA_LOCAL_API_KEY_FILE=

# Ollama Cloud provider seed for Butler, Pi Workers, and Pi background tasks.
MANOR_OLLAMA_CLOUD_ENABLED=1
MANOR_OLLAMA_CLOUD_PROVIDER_ID=ollama-cloud
MANOR_OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
MANOR_OLLAMA_CLOUD_API=openai-completions
MANOR_OLLAMA_CLOUD_MODELS=gpt-oss:120b,glm-5.2,kimi-k2.6,qwen3.5,deepseek-v4-flash,minimax-m3
MANOR_OLLAMA_CLOUD_CONTEXT_WINDOW=131072
MANOR_OLLAMA_CLOUD_MAX_TOKENS=32768
OLLAMA_API_KEY=
OLLAMA_API_KEY_FILE=

# Ollama Cloud web tools (search & fetch). Attached to workers using Ollama models.
MANOR_OLLAMA_WEB_TOOLS_ENABLED=1
MANOR_OLLAMA_WEB_TOOLS_BASE_URL=https://ollama.com/api
MANOR_OLLAMA_WEB_SEARCH_MAX_RESULTS=5
MANOR_OLLAMA_WEB_TOOLS_TIMEOUT_MS=30000
MANOR_OLLAMA_WEB_TOOLS_MAX_CONTENT_CHARS=12000
# Set to 1 only if non-Ollama Pi models should also get Ollama-backed web_search/web_fetch.
MANOR_OLLAMA_WEB_TOOLS_FOR_ALL_PI_MODELS=0

# External content review: review (warn and continue), enforce (block hostile delivery), or off.
MANOR_CONTENT_ADMISSION_MODE=review
# Model used only for Content Admission Review. Leave empty to use the first authenticated background model.
MANOR_CONTENT_ADMISSION_MODEL=

# OpenCode Go provider seed for Butler, Pi Workers, and Pi background tasks.
# Models are served from https://opencode.ai/zen/go/v1. Some models
# (MiniMax, Qwen) use the Anthropic API shape; the rest use openai-completions.
# The provider is enabled by default but only activates when OPENCODE_API_KEY
# (or OPENCODE_API_KEY_FILE) is present before Manor starts.
MANOR_OPENCODE_GO_ENABLED=1
MANOR_OPENCODE_GO_PROVIDER_ID=opencode-go
MANOR_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_API_KEY_FILE=

# OpenCode Go web tools (search & fetch via Exa AI). No API key needed.
# Enabled with MANOR_OPENCODE_GO_WEB_TOOLS_ENABLED=1. Attached to workers
# using OpenCode models.
MANOR_OPENCODE_GO_WEB_TOOLS_ENABLED=0

# Worker and Butler default seeds.
MANOR_WORKER_MODEL=
MANOR_WORKER_EFFORT=
MANOR_BUTLER_MODEL=
MANOR_BUTLER_THINKING_LEVEL=medium

# Manor memory/model-task seeds. All provider model refs route through Pi.
MANOR_MEMORY_SYNTHESIS_ENABLED=1
MANOR_MEMORY_SYNTHESIS_MODEL=openai-codex/gpt-5.4-mini
MANOR_MEMORY_SYNTHESIS_EFFORT=
MANOR_MEMORY_SYNTHESIS_TIMEOUT_MS=90000
MANOR_MEMORY_SYNTHESIS_MAX_INPUT_CHARS=16000
MANOR_MEMORY_SYNTHESIS_MAX_CANDIDATES=6
MANOR_MEMORY_PROMOTION_MODEL=
MANOR_MEMORY_PROMOTION_AUTO_RESOLVE=1
MANOR_MEMORY_PROMOTION_BATCH_SIZE=20
MANOR_MEMORY_PROMOTION_MAX_BATCHES_PER_RUN=10
MANOR_MEMORY_PROMOTION_INTERVAL_MS=10000
MANOR_ROUTING_CLASSIFIER_MODEL=
MANOR_MEMORY_SEMANTIC_EDGES_ENABLED=1
MANOR_MEMORY_SEMANTIC_EDGES_BATCH_SIZE=12
MANOR_MEMORY_SEMANTIC_EDGES_INTERVAL_MS=60000

# Optional fast model pass for naming new Butler sessions.
MANOR_SESSION_TITLE_MODEL=openai-codex/gpt-5.4-mini
MANOR_SESSION_TITLE_TIMEOUT_MS=15000

# Local embedding retrieval seed.
MANOR_MEMORY_EMBEDDINGS_ENABLED=1
MANOR_MEMORY_EMBEDDINGS_PROVIDER=ollama
MANOR_MEMORY_EMBEDDINGS_HOST=http://127.0.0.1:11434
MANOR_MEMORY_EMBEDDINGS_MODEL=qwen3-embedding:0.6b
MANOR_MEMORY_EMBEDDINGS_TIMEOUT_MS=120000
MANOR_MEMORY_EMBEDDINGS_BACKFILL_BATCH_SIZE=16

# Backwards-compatible seed alias for older memory review configuration.
MANOR_MEMORY_REVIEW_MODEL=

# Optional auth bootstrap. Leave empty when using device-code login.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
